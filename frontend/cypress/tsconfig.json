{
  // Extends the root tsconfig, and not `tsconfig.spec.json`: `strict`, `noImplicitReturns` and
  // the rest of the strictness that applies to `src/` applies just as much here — a lax test is
  // a test that passes by accident.
  //
  // The only thing that changes is `types`. `tsconfig.spec.json` declares `types: ["jasmine"]`,
  // and the Mocha/Chai globals that Cypress brings collide with Jasmine's (`expect`, `it.only`,
  // `beforeEach`) — two incompatible declarations of the same name. The separation does not
  // require touching `tsconfig.app.json` or `tsconfig.spec.json`: both are already scoped to
  // `src/`, so this top-level directory is invisible to both. All that was missing was excluding
  // `cypress/` from the root tsconfig, which has no `include` and therefore picks up everything.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "node"],
    "outDir": "../dist/out-tsc/cypress",
    "sourceMap": false
  },
  // The root tsconfig's `exclude` lists `cypress`, and it is inherited: without zeroing it out
  // here this project would exclude its own files.
  "exclude": [],
  "include": ["**/*.ts"]
}
