# SecurityHub - example environment. Copy to .env and replace every value.
# Never commit the resulting .env file.

# --- Database ---
POSTGRES_DB=securityhub
POSTGRES_USER=securityhub
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=demo
# Generate a new one with: openssl rand -base64 48
SECURITYHUB_JWT_SECRET=replace-with-a-random-base64-secret-at-least-32-bytes-long
SECURITYHUB_JWT_EXPIRATION_MINUTES=60
SECURITYHUB_REFRESH_EXPIRATION_DAYS=14
SECURITYHUB_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# --- Frontend ---
FRONTEND_PORT=8081
