# SecurityHub - example environment. Copy to .env and replace every value.
# Never commit the resulting .env file.

# --- Database ---
POSTGRES_DB=securityhub
POSTGRES_USER=securityhub
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Port for the actuator endpoints, deliberately separate from the application port: the ADMIN
# of this product is a customer's administrator, not an operator, and JVM metrics are not
# theirs. Compose publishes this port on 127.0.0.1 only — it has no authentication of its own,
# and network isolation is the control.
MANAGEMENT_PORT=9090
SPRING_PROFILES_ACTIVE=demo
# Generate a new one with: openssl rand -base64 48
SECURITYHUB_JWT_SECRET=replace-with-a-random-base64-secret-at-least-32-bytes-long
SECURITYHUB_JWT_EXPIRATION_MINUTES=60
SECURITYHUB_REFRESH_EXPIRATION_DAYS=14
SECURITYHUB_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
# Password shared by the accounts created by the `demo` profile seed. A public credential of
# the local demonstration, not a secret: the `demo` tenant only exists in the database you have
# just created on your own machine. Override this value in any exposed deployment.
SECURITYHUB_DEMO_PASSWORD=Demo@SecurityHub2026

# --- Frontend ---
FRONTEND_PORT=8081

# Transactional e-mail. In development it points at the compose MailHog; the inbox is at
# http://localhost:8025. In production, point it at a real relay.
MAIL_HOST=mailhog
MAIL_PORT=1025
SECURITYHUB_MAIL_FROM=nao-responda@securityhub.local
SECURITYHUB_APP_BASE_URL=http://localhost:8081
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
