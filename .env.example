# SecurityHub - example environment. Copy to .env and replace every value.
# Never commit the resulting .env file.

# --- Database ---
POSTGRES_DB=securityhub
POSTGRES_USER=securityhub
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=demo
# Generate a new one with: openssl rand -base64 48
SECURITYHUB_JWT_SECRET=replace-with-a-random-base64-secret-at-least-32-bytes-long
SECURITYHUB_JWT_EXPIRATION_MINUTES=60
SECURITYHUB_REFRESH_EXPIRATION_DAYS=14
SECURITYHUB_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
# Senha compartilhada pelas contas criadas pelo seed do perfil `demo`. Credencial pública da
# demonstração local, e não um segredo: o tenant `demo` só existe no banco que você acabou de
# criar na sua máquina. Sobrescreva este valor em qualquer implantação exposta.
SECURITYHUB_DEMO_PASSWORD=Demo@SecurityHub2026

# --- Frontend ---
FRONTEND_PORT=8081

# E-mail transacional. Em desenvolvimento aponta para o MailHog do compose; a caixa de
# entrada fica em http://localhost:8025. Em produção, aponte para um relay real.
MAIL_HOST=mailhog
MAIL_PORT=1025
SECURITYHUB_MAIL_FROM=nao-responda@securityhub.local
SECURITYHUB_APP_BASE_URL=http://localhost:8081
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
