<?xml version="1.0" encoding="UTF-8"?>
<!--
  The file name is part of the configuration: it has to be `logback-spring.xml`, not
  `logback.xml`. Logback reads `logback.xml` on its own, before the Spring context exists —
  and at that moment `<springProfile>` and `<springProperty>` are unknown tags, inert. Only the
  `-spring` suffix makes Boot take over the reading and resolve the profiles; under the other
  name everyone would land on the same appender, silently.

  Output to stdout only, with no file appender: inside a container the runtime is what collects
  the log, and a file inside the image is a disk filling up that nobody is watching.
-->
<configuration>

  <!--
    Brings in CONSOLE_LOG_PATTERN, the colour converters and Boot's default levels. It is what
    keeps the human-readable pattern fed by `logging.pattern.console` in application.yml: the
    readable format stays defined in one place instead of being duplicated here.
  -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty scope="context" name="serviceName" source="spring.application.name"
                  defaultValue="securityhub"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <!-- UTC everywhere, like the rest of the application (Jackson, Hibernate and the CSV). -->
      <timeZone>UTC</timeZone>

      <!--
        Sem as propriedades do contexto do Logback. O <springProperty> acima grava `serviceName`
        there, and with includeContext on (the default) the same value would be emitted twice on
        linha — uma como `serviceName`, outra como o `service` declarado logo abaixo. O nome do
        every line. The field is a contract with the collector: one of them, and explicit.
      -->
      <includeContext>false</includeContext>

      <!--
        The MDC goes in by allowlist, not wholesale. `traceId` is promoted to a top-level field,
        which is how a collector correlates requests; any future key has to be added here
        deliberately. Without that, the first MDC key somebody sets holding sensitive data would
        be serialised on every line, by accident.
      -->
      <includeMdc>true</includeMdc>
      <includeMdcKeyName>traceId</includeMdcKeyName>

      <customFields>{"service":"${serviceName}"}</customFields>

      <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
        <rootCauseFirst>true</rootCauseFirst>
        <maxDepthPerThrowable>30</maxDepthPerThrowable>
        <maxLength>8192</maxLength>
      </throwableConverter>
    </encoder>
  </appender>

  <!--
    `demo` stays readable on purpose: whoever brings compose up and runs `docker compose logs
    backend` to find the seeded credentials has to be able to read the output. `test` for the
    same reason — a build that breaks with the log in JSON is a build nobody diagnoses.
  -->
  <springProfile name="dev,test,demo">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="prod">
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>

</configuration>
