### SecurityHub — request collection
### Compatible with the VS Code REST Client and with the IntelliJ HTTP client.
### No secrets here: the token is captured from the login response at run time.
###
### The file is a flow: run top to bottom against a stack with the `demo` profile
### (docker compose up), each block feeds the next through the captured variables.
### Section 12 gathers the negative cases and section 13 undoes what was created.
### Detailed response for each endpoint: docs/api-examples.md

@baseUrl = http://localhost:8080/api/v1
@demoEmail = admin@demo.test
@demoPassword = Demo@SecurityHub2026

############################################################
### 1. Authentication
############################################################

### 1.1 Registration of a new company with its first administrator
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "companyName": "Acme Segurança",
  "name": "Administrador",
  "email": "admin@acme.test",
  "password": "uma-senha-suficientemente-longa"
}

### 1.2 Login — stores the access token for the following calls
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{demoEmail}}",
  "password": "{{demoPassword}}"
}

@token = {{login.response.body.accessToken}}
@userId = {{login.response.body.user.id}}

### 1.3 Authenticated user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 1.4 Login as DEVELOPER — used in the 403 cases of section 11
# @name loginDeveloper
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "developer@demo.test",
  "password": "{{demoPassword}}"
}

@devToken = {{loginDeveloper.response.body.accessToken}}

### 1.5 Login as VIEWER — a strictly read-only role
# @name loginViewer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "viewer@demo.test",
  "password": "{{demoPassword}}"
}

@viewerToken = {{loginViewer.response.body.accessToken}}

### 1.6 Login into the second tenant — used in the 404 isolation cases
# @name loginOtherCompany
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@northwind.test",
  "password": "{{demoPassword}}"
}

@otherToken = {{loginOtherCompany.response.body.accessToken}}

############################################################
### 2. Projects
############################################################

### 2.1 Paginated, filtered and sorted listing
GET {{baseUrl}}/projects?page=0&size=20&sort=createdAt,desc&search=portal&status=ACTIVE
Authorization: Bearer {{token}}

### 2.2 Create a project (ADMIN only)
# @name createProject
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Portal do Cliente",
  "description": "Aplicação web voltada ao cliente final",
  "status": "ACTIVE"
}

@projectId = {{createProject.response.body.id}}

### 2.3 Project detail
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{token}}

### 2.4 Update a project
PUT {{baseUrl}}/projects/{{projectId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Portal do Cliente",
  "description": "Descrição revisada",
  "status": "ACTIVE"
}

############################################################
### 3. Assets
############################################################

### 3.1 Listing with every filter of the module
GET {{baseUrl}}/assets?page=0&size=20&sort=criticality,desc&search=api&projectId={{projectId}}&type=API&environment=PRODUCTION&criticality=CRITICAL
Authorization: Bearer {{token}}

### 3.2 Create an asset (ADMIN only)
# @name createAsset
POST {{baseUrl}}/assets
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "projectId": {{projectId}},
  "name": "API de pagamentos",
  "description": "Processa cobranças e estornos",
  "type": "API",
  "identifier": "api.pagamentos.acme.test",
  "environment": "PRODUCTION",
  "criticality": "CRITICAL"
}

@assetId = {{createAsset.response.body.id}}

### 3.3 Asset detail
GET {{baseUrl}}/assets/{{assetId}}
Authorization: Bearer {{token}}

### 3.4 Update an asset — a blank identifier means "no identifier"
PUT {{baseUrl}}/assets/{{assetId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "projectId": {{projectId}},
  "name": "API de pagamentos",
  "description": "Processa cobranças, estornos e conciliação",
  "type": "API",
  "identifier": "api.pagamentos.acme.test",
  "environment": "PRODUCTION",
  "criticality": "HIGH"
}

############################################################
### 4. Vulnerabilities
############################################################

### 4.1 Listing with every filter of the module
GET {{baseUrl}}/vulnerabilities?page=0&size=20&sort=cvssScore,desc&search=injection&projectId={{projectId}}&assetId={{assetId}}&severity=CRITICAL&status=OPEN&overdue=false
Authorization: Bearer {{token}}

### 4.2 Create a vulnerability (ADMIN or ANALYST) — always born OPEN, no status in the body
# @name createVulnerability
POST {{baseUrl}}/vulnerabilities
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assetId": {{assetId}},
  "title": "SQL injection no endpoint de busca",
  "description": "Parâmetro concatenado diretamente na query",
  "severity": "CRITICAL",
  "cvssScore": 9.1,
  "cve": "CVE-2024-12345",
  "discoveredAt": "2026-09-17T12:02:00Z",
  "dueDate": "2026-10-01T00:00:00Z"
}

@vulnerabilityId = {{createVulnerability.response.body.id}}

### 4.3 Vulnerability detail
GET {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}
Authorization: Bearer {{token}}

### 4.4 Assign to an active user of the same company (ADMIN or ANALYST)
PATCH {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/assignee
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": {{userId}}
}

### 4.5 Change the status to IN_PROGRESS
PATCH {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "IN_PROGRESS"
}

### 4.6 Update the vulnerability — PUT never changes status or resolvedAt
PUT {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assetId": {{assetId}},
  "title": "SQL injection no endpoint de busca de pedidos",
  "description": "Parâmetro concatenado diretamente na query; reproduzido em homologação",
  "severity": "CRITICAL",
  "cvssScore": 9.4,
  "cve": "CVE-2024-12345",
  "discoveredAt": "2026-09-17T12:02:00Z",
  "dueDate": "2026-10-01T00:00:00Z",
  "assignedToId": {{userId}}
}

### 4.7 Overdue items — overdue=true uses the same predicate as the dashboard card
GET {{baseUrl}}/vulnerabilities?overdue=true&sort=dueDate,asc&size=20
Authorization: Bearer {{token}}

### 4.8 The dashboard's "recent items" panel — it is this listing, not a fifth endpoint
GET {{baseUrl}}/vulnerabilities?page=0&size=5&sort=createdAt,desc
Authorization: Bearer {{token}}

############################################################
### 5. Comments
############################################################

### 5.1 Comment (ADMIN, ANALYST or DEVELOPER)
# @name createComment
POST {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/comments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "content": "Correção iniciada; o parâmetro passa a usar bind."
}

@commentId = {{createComment.response.body.id}}

### 5.2 List comments — ascending order by createdAt, unlike the rest of the API
GET {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/comments?page=0&size=20
Authorization: Bearer {{token}}

### 5.3 Edit your own comment (author or ADMIN)
PUT {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/comments/{{commentId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "content": "Correção iniciada; o parâmetro passa a usar bind. PR aberto."
}

############################################################
### 6. Resolving
############################################################

### 6.1 Entering RESOLVED stamps resolvedAt; leaving RESOLVED would clear the stamp
PATCH {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "RESOLVED"
}

### 6.2 Unassign — a null userId is a valid request
PATCH {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/assignee
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": null
}

############################################################
### 7. Users
############################################################

### 7.1 Users of the company (ADMIN and ANALYST) — plain array, no pagination
GET {{baseUrl}}/users?active=true
Authorization: Bearer {{token}}

### 7.2 Filtered by role and text
GET {{baseUrl}}/users?role=DEVELOPER&active=true&search=mendes
Authorization: Bearer {{token}}

############################################################
### 8. Audit trail
############################################################

### 8.1 Audit trail (ADMIN only)
GET {{baseUrl}}/audit-logs?page=0&size=20&entityType=Project
Authorization: Bearer {{token}}

### 8.2 Filtered by action, actor and time window
GET {{baseUrl}}/audit-logs?page=0&size=50&entityType=Vulnerability&action=STATUS_CHANGE&actorId={{userId}}&from=2026-01-01T00:00:00Z&to=2026-12-31T23:59:59Z&sort=createdAt,desc
Authorization: Bearer {{token}}

############################################################
### 9. Dashboard
############################################################

### 9.1 Cards — openVulnerabilities is OPEN + IN_PROGRESS, not a status count
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{token}}

### 9.2 Distribution by severity — array with all four severities, including the empty ones
GET {{baseUrl}}/dashboard/severity-distribution
Authorization: Bearer {{token}}

### 9.3 Distribution by status — array with all four statuses, including the empty ones
GET {{baseUrl}}/dashboard/status-distribution
Authorization: Bearer {{token}}

### 9.4 Daily series of opened and resolved
GET {{baseUrl}}/dashboard/trend?days=30
Authorization: Bearer {{token}}

### 9.5 days is silently clamped to [1, 90] — answers 200 with "days": 90
GET {{baseUrl}}/dashboard/trend?days=365
Authorization: Bearer {{token}}

############################################################
### 10. Scan import
############################################################

### The file uploaded is the scan-nmap-exemplo.xml next to this one. It points at
### `api.pagamentos.acme.test` — the identifier of the asset created in 3.2, which the finding
### matches on its own — and at an address from the documentation range, which is not in the
### inventory and therefore stays unmatched. Open ports with no script do not become findings.

### 10.1 Upload the report (ADMIN or ANALYST) — nothing is created yet, it is only a proposal
# @name uploadScan
POST {{baseUrl}}/scan-imports
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=ScanBoundary

--ScanBoundary
Content-Disposition: form-data; name="projectId"

{{projectId}}
--ScanBoundary
Content-Disposition: form-data; name="format"

NMAP_XML
--ScanBoundary
Content-Disposition: form-data; name="file"; filename="scan-nmap-exemplo.xml"
Content-Type: application/xml

< ./scan-nmap-exemplo.xml
--ScanBoundary--

@scanImportId = {{uploadScan.response.body.id}}
### An array index needs JSONPath (the `$.`), unlike the scalar captures above.
### The order of the findings is the report's: first the host that matched, then the one that
### did not.
@matchedFindingId = {{uploadScan.response.body.$.findings[0].id}}
@unmatchedFindingId = {{uploadScan.response.body.$.findings[1].id}}

### 10.2 Preview — the import with all its findings; check status PENDING and the counters
### (totalFindings 2, matchedCount 1, unmatchedCount 1)
GET {{baseUrl}}/scan-imports/{{scanImportId}}
Authorization: Bearer {{token}}

### 10.3 Link the unmatched finding (ADMIN or ANALYST) — the asset only has to belong to the company
PATCH {{baseUrl}}/scan-imports/{{scanImportId}}/findings/{{unmatchedFindingId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assetId": {{assetId}}
}

### 10.4 Link a finding that already has an asset — 409 expected, there is nothing to change
PATCH {{baseUrl}}/scan-imports/{{scanImportId}}/findings/{{matchedFindingId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assetId": {{assetId}}
}

### 10.5 Confirm — creates one vulnerability per matched finding, in a single batch,
### and leaves **one** SCAN_IMPORT row in the audit trail (not a CREATE per finding)
# @name confirmScan
POST {{baseUrl}}/scan-imports/{{scanImportId}}/confirm
Authorization: Bearer {{token}}

@importedVulnerabilityA = {{confirmScan.response.body.$.findings[0].vulnerabilityId}}
@importedVulnerabilityB = {{confirmScan.response.body.$.findings[1].vulnerabilityId}}

### 10.6 Confirm again — 409 expected: the first confirmation created rows, and a 200 here
### would tell whoever repeated the call that it created rows too
POST {{baseUrl}}/scan-imports/{{scanImportId}}/confirm
Authorization: Bearer {{token}}

### 10.7 Discard an already confirmed import — 409 expected; its file backs vulnerabilities
### that exist
DELETE {{baseUrl}}/scan-imports/{{scanImportId}}
Authorization: Bearer {{token}}

### 10.8 Upload the same file again — duplicateCount equal to totalFindings and matchedCount
### zero. Re-importing never merges and never reopens: the vulnerability from the first import
### may already have a status, an assignee and a discussion, and none of that can be undone by
### a file.
# @name uploadScanAgain
POST {{baseUrl}}/scan-imports
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=ScanBoundary

--ScanBoundary
Content-Disposition: form-data; name="projectId"

{{projectId}}
--ScanBoundary
Content-Disposition: form-data; name="format"

NMAP_XML
--ScanBoundary
Content-Disposition: form-data; name="file"; filename="scan-nmap-exemplo.xml"
Content-Type: application/xml

< ./scan-nmap-exemplo.xml
--ScanBoundary--

@scanImportAgainId = {{uploadScanAgain.response.body.id}}

### 10.9 Discard the re-import — 204. The file on disk goes; the finding rows stay, and that
### is how someone answers later "we scanned, and we chose not to import"
DELETE {{baseUrl}}/scan-imports/{{scanImportAgainId}}
Authorization: Bearer {{token}}

### 10.10 The discarded one stays in the history, now with status DISCARDED
GET {{baseUrl}}/scan-imports/{{scanImportAgainId}}
Authorization: Bearer {{token}}

### 10.11 Paginated history — the counters of each import, without the findings
GET {{baseUrl}}/scan-imports?page=0&size=20&sort=createdAt,desc
Authorization: Bearer {{token}}

### 10.12 Format outside the enum — 400 BAD_REQUEST expected, at parameter conversion
POST {{baseUrl}}/scan-imports?projectId={{projectId}}&format=NESSUS_XML
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=ScanBoundary

--ScanBoundary
Content-Disposition: form-data; name="file"; filename="scan-nmap-exemplo.xml"
Content-Type: application/xml

< ./scan-nmap-exemplo.xml
--ScanBoundary--

### 10.13 VIEWER uploading a report — 403 expected. The multipart goes complete on purpose:
### projectId and format are resolved before the role check, and an incomplete body would
### return 400 without the permission rule ever running.
POST {{baseUrl}}/scan-imports
Authorization: Bearer {{viewerToken}}
Content-Type: multipart/form-data; boundary=ScanBoundary

--ScanBoundary
Content-Disposition: form-data; name="projectId"

{{projectId}}
--ScanBoundary
Content-Disposition: form-data; name="format"

NMAP_XML
--ScanBoundary
Content-Disposition: form-data; name="file"; filename="scan-nmap-exemplo.xml"
Content-Type: application/xml

< ./scan-nmap-exemplo.xml
--ScanBoundary--

### 10.14 An import from another company — 404 expected, never 403
GET {{baseUrl}}/scan-imports/{{scanImportId}}
Authorization: Bearer {{otherToken}}

############################################################
### 11. Silent behaviours worth seeing
############################################################

### 11.1 A sort outside the allowlist is discarded — check "sort" in the response: "createdAt,desc"
GET {{baseUrl}}/projects?sort=passwordHash,asc&size=5
Authorization: Bearer {{token}}

### 11.2 A size above the maximum is capped at 100 — check "size" in the response
GET {{baseUrl}}/vulnerabilities?size=500
Authorization: Bearer {{token}}

############################################################
### 12. Negative cases
############################################################

### 12.1 Protected endpoint with no token — 401 UNAUTHORIZED expected
GET {{baseUrl}}/projects

### 12.2 Invalid token — 401 UNAUTHORIZED expected (same body as the previous case)
GET {{baseUrl}}/projects
Authorization: Bearer token-invalido-qualquer

### 12.3 Wrong credentials — 401 expected with "Credenciais inválidas"
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{demoEmail}}",
  "password": "senha-obviamente-errada"
}

### 12.4 DEVELOPER creating a project — 403 FORBIDDEN expected ("Acesso negado")
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "name": "Projeto que o developer não pode criar"
}

### 12.5 DEVELOPER changing the status of an item assigned to someone else
### 403 expected with "Você só pode alterar o status de vulnerabilidades atribuídas a você"
### (run 4.4 first: the item has to be assigned to the ADMIN)
PATCH {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/status
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "status": "RESOLVED"
}

### 12.6 VIEWER commenting — 403 FORBIDDEN expected, the role is read-only
POST {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/comments
Content-Type: application/json
Authorization: Bearer {{viewerToken}}

{
  "content": "Comentário que o viewer não pode escrever"
}

### 12.7 DEVELOPER querying the audit trail — 403 FORBIDDEN expected (ADMIN only)
GET {{baseUrl}}/audit-logs
Authorization: Bearer {{devToken}}

### 12.8 A project from another company — 404 NOT_FOUND expected, never 403
### A 403 would confirm that the row exists and would turn the API into an enumeration oracle
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{otherToken}}

### 12.9 Delete a resource from another company — 404 NOT_FOUND expected
DELETE {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}
Authorization: Bearer {{otherToken}}

### 12.10 Reference to a non-existent project in the body — 404 expected ("Projeto ... não encontrado")
POST {{baseUrl}}/assets
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "projectId": 999999,
  "name": "Ativo órfão",
  "type": "SERVER",
  "environment": "TEST",
  "criticality": "LOW"
}

### 12.11 Unknown, inactive or foreign-company assignee — 404 expected ("Usuário ... não encontrado")
PATCH {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}/assignee
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": 999999
}

### 12.12 Duplicate project name — 409 CONFLICT expected
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Portal do Cliente"
}

### 12.13 Duplicate asset identifier in the same project — 409 CONFLICT expected
POST {{baseUrl}}/assets
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "projectId": {{projectId}},
  "name": "Outro ativo, mesmo identificador",
  "type": "API",
  "identifier": "api.pagamentos.acme.test",
  "environment": "PRODUCTION",
  "criticality": "LOW"
}

### 12.14 E-mail already registered — 409 CONFLICT expected (uniqueness is global, not per company)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "companyName": "Outra Empresa",
  "name": "Outro Administrador",
  "email": "{{demoEmail}}",
  "password": "uma-senha-suficientemente-longa"
}

### 12.15 Delete a project that still has assets — 409 CONFLICT expected, with the count
DELETE {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{token}}

### 12.16 Delete an asset that still has vulnerabilities — 409 CONFLICT expected, with the count
DELETE {{baseUrl}}/assets/{{assetId}}
Authorization: Bearer {{token}}

### 12.17 Invalid payload — 400 VALIDATION_ERROR expected, with fieldErrors
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": ""
}

### 12.18 Several invalid fields at once — 400 expected with four fieldErrors
POST {{baseUrl}}/vulnerabilities
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "ab",
  "cvssScore": 12.5
}

### 12.19 Non-existent enum value — 400 BAD_REQUEST expected, with no fieldErrors
### The failure is in deserialisation and happens before validation runs
POST {{baseUrl}}/vulnerabilities
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assetId": {{assetId}},
  "title": "Severidade que não existe",
  "severity": "URGENTE"
}

### 12.20 Incompatible type in the query string — 400 BAD_REQUEST expected
GET {{baseUrl}}/vulnerabilities?projectId=abc
Authorization: Bearer {{token}}

############################################################
### 13. Cleanup — in the order that respects the children rule
############################################################

### 13.1 Delete the vulnerability (ADMIN only); the comments go with it
DELETE {{baseUrl}}/vulnerabilities/{{vulnerabilityId}}
Authorization: Bearer {{token}}

### 13.2 Delete the first vulnerability created by the section 10 import.
### Without these two the asset does not go: it has children again, and the deletion answers 409
### with the count. Whoever skipped section 10 skips 13.2 and 13.3.
###
### Note: today both answer 409 ("A operação conflita com dados existentes"), because
### scan_findings.vulnerability_id references the row and VulnerabilityService.delete only
### handles comments and attachments. While that is the case, an imported vulnerability cannot
### be deleted through the API, and 13.4 and 13.5 fail next because of the children rule.
DELETE {{baseUrl}}/vulnerabilities/{{importedVulnerabilityA}}
Authorization: Bearer {{token}}

### 13.3 Delete the second vulnerability created by the import
DELETE {{baseUrl}}/vulnerabilities/{{importedVulnerabilityB}}
Authorization: Bearer {{token}}

### 13.4 Delete the asset, now with no children
DELETE {{baseUrl}}/assets/{{assetId}}
Authorization: Bearer {{token}}

### 13.5 Delete the project, now with no children
DELETE {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{token}}
